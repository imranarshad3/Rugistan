# Public browser configuration (Vite)
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Server-only configuration. Never expose through VITE_ variables.
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CLERK_SECRET_KEY=

# At least 32 random characters; server HMAC key for short-lived rate-limit identities.
RATE_LIMIT_SECRET=

# Optional admin photo analysis. Server-only; never use a VITE_ prefix.
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
